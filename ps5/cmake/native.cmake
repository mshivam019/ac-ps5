# Use the existing native-app compiler and PS5 SDL2/OpenGL installation.
set(PS5 TRUE)
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(PS5SDK_ROOT "$ENV{HOME}/ps5sdk" CACHE PATH "Local PS5 SDK workspace")
set(PS5_NATIVE_APP_TEMPLATE "${PS5SDK_ROOT}/native-app-boilerplate" CACHE PATH "Native app tooling")
set(PS5_OPENGL_ROOT "${PS5SDK_ROOT}/ps5-opengl-030/ps5-opengl" CACHE PATH "OpenGL checkout")
set(PS5_SDL2_PREFIX "${PS5_OPENGL_ROOT}/build/sdl2-native/sdk" CACHE PATH "Native SDL2 prefix")
set(PS5_OPENGL_PREFIX "${PS5SDK_ROOT}/extracted/ps5-opengl-sdk-0.3.0/sdk" CACHE PATH "OpenGL SDK prefix")
set(PS5_PAYLOAD_SDK "${PS5_NATIVE_APP_TEMPLATE}/.deps/native/ps5-payload-sdk")
set(ENV{PS5_PAYLOAD_SDK} "${PS5_PAYLOAD_SDK}")
set(CMAKE_C_COMPILER "${PS5_NATIVE_APP_TEMPLATE}/tooling/prospero-clang18")
set(CMAKE_CXX_COMPILER "${PS5_NATIVE_APP_TEMPLATE}/tooling/prospero-clang18++")
find_program(CMAKE_AR NAMES llvm-ar-18 llvm-ar REQUIRED)
find_program(CMAKE_RANLIB NAMES llvm-ranlib-18 llvm-ranlib REQUIRED)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-D__PROSPERO__ -fPIC -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "-D__PROSPERO__ -fexceptions -fcxx-exceptions -frtti -fPIC -ffunction-sections -fdata-sections")
set(CMAKE_FIND_ROOT_PATH "${PS5_SDL2_PREFIX}" "${PS5_OPENGL_PREFIX}" "${PS5_PAYLOAD_SDK}/target")
set(CMAKE_PREFIX_PATH "${PS5_SDL2_PREFIX}" "${PS5_OPENGL_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
